server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Future OCR API (uncomment + run OCR container)
    # location /api/ocr/ {
    #     proxy_pass http://ocr:8080/;
    #     proxy_set_header Host $host;
    #     client_max_body_size 20m;
    # }
}
